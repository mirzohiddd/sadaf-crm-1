# Mavjud SADAF CRM backendingiz manzili (schema bilan, oxirida / bo'lmasin)
# Frontend so'rov yuboradi: POST ${VITE_API_BASE_URL}/api/integrations/website/lead
VITE_API_BASE_URL=https://api.sadaf-travel.uz

# CRM backendning WEBSITE_WEBHOOK_SECRET qiymati bilan BIR XIL bo'lishi shart.
# (backend/.env dagi WEBSITE_WEBHOOK_SECRET)
VITE_LEAD_API_KEY=change-me-website-secret
